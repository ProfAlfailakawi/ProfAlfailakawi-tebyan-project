{
  "entities": {
    "ripple": {
      "title": "Ripple",
      "description": "An idea node in the ripple effect tree",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "type": { "type": "string", "enum": ["seed", "branch", "implementation"] },
        "likes": { "type": "number" },
        "timestamp": { "type": "string" },
        "parentId": { "type": "string" }
      },
      "required": ["id", "text", "author", "type", "likes"]
    }
  },
  "firestore": {
    "/ripples/{rippleId}": {
      "schema": "ripple",
      "description": "All ripple nodes"
    }
  }
}
