// ⚠️ OBSOLETE DRAFT — DO NOT DEPLOY THIS FILE. ⚠️
//
// Its only real contribution — the role-escalation guard on /users/{userId} —
// now lives in the published `firestore.rules`, which is the file firebase.json
// actually deploys.
//
// Deploying this draft would take the live site down: it declares a default-deny
// and then defines rules for /users only, so every other collection the app
// depends on (ripples, daily_prompts, qawl_fasl_questions, system_settings,
// system_config, search_logs, ai_logs, analytics, admins) would be denied.
// It would also block legitimate writes the app makes today:
//   - `incoming().role == 'user'` on create forbids the owner's own admin
//     profile sync in src/components/AuthProvider.tsx;
//   - `incoming().email == request.auth.token.email` forbids any account
//     without an e-mail claim;
//   - `allow list: if false` breaks the admin user list.
//
// Kept only as a historical record of the fix. See SECURITY-TODO.md §2.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && incoming().role == 'user' && incoming().email == request.auth.token.email;
      allow update: if isOwner(userId) && incoming().role == existing().role;
      allow list: if false;
    }
  }
}
