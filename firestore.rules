rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Validations
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidRipple(data) {
      return data.text is string && data.text.size() <= 200000 &&
             data.type in ['seed', 'branch', 'implementation'] &&
             data.likes is number &&
             data.timestamp is string &&
             (data.parentId == null || data.parentId is string);
    }
    
    match /system_settings/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    match /ripples/{rippleId} {
      allow list: if true; // Publicly readable for the community board
      allow get: if true;
      allow create: if isValidRipple(request.resource.data);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('authorId', '') || 
        (resource.data.get('rootId', '') != '' && get(/databases/$(database)/documents/ripples/$(resource.data.rootId)).data.get('authorId', '') == request.auth.uid) ||
        (request.auth.token.get('email', '').toLower() == "alfailakawidrahmad@gmail.com") ||
        (request.auth.token.get('email', '').toLower() == "dr.ahmad@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      
      match /likes/{userId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    match /analytics/{docId} {
        allow write: if true;
    }
  }
}
